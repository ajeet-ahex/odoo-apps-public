<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_spt" model="ir.ui.view">
        <field name="name">stock.picking.form.spt</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='move_ids']//field[@name='product_id']"
                   position="before">
                <field name="is_selected_for_transfer"
                       string="Transfer"
                       column_invisible="parent.state in ('done', 'cancel')"
                       help="Tick to transfer this product now. Un-tick to push it to a backorder on validation."/>
            </xpath>
        </field>
    </record>

</odoo>
